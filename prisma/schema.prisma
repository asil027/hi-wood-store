generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  phone        String?
  role         String      @default("CUSTOMER") // "ADMIN" or "CUSTOMER"
  avatar       String?
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlists    Wishlist[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  addressLine String
  city        String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Collection {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  subtitle      String?   // e.g. "Simple • Stylish • Daily Use"
  description   String?
  image         String?
  startingPrice Float?    // e.g. 2499
  bgTheme       String?   // pastel color code e.g. "#FDF6EE" or "#F3F0FA"
  displayOrder  Int       @default(0)
  isActive      Boolean   @default(true)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  sku              String           @unique
  shortDescription String?
  description      String
  price            Float
  salePrice        Float?
  stock            Int              @default(10)
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isPublished      Boolean          @default(true)
  rating           Float            @default(5.0)
  reviewCount      Int              @default(0)
  specs            String?          // JSON string: material, dimensions, capacity, weight, etc.
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collectionId     String?
  collection       Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlists        Wishlist[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String
  colorHex  String   @default("#000000")
  size      String?
  sku       String?
  stock     Int      @default(10)
  price     Float?
  image     String?
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // e.g. "HW-2026-1001"
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String
  city            String
  deliveryNotes   String?
  paymentMethod   String      @default("COD") // "COD", "BANK_TRANSFER", "ONLINE"
  paymentStatus   String      @default("PENDING") // "PENDING", "PAID", "FAILED"
  orderStatus     String      @default("PENDING") // "PENDING", "CONFIRMED", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED", "RETURNED"
  subtotal        Float
  discountAmount  Float       @default(0)
  couponCode      String?
  shippingFee     Float       @default(0)
  totalAmount     Float
  courierName     String?     // e.g. "TCS", "Leopards", "Trax"
  trackingNumber  String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  image       String?
  price       Float
  quantity    Int      @default(1)
  color       String?
  size        String?
  total       Float
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String    @default("PERCENT") // "PERCENT" or "FIXED"
  discountValue  Float     // e.g. 10 (%) or 500 (Rs.)
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int?      @default(100)
  timesUsed      Int       @default(0)
  startsAt       DateTime  @default(now())
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userEmail  String?
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model StoreSettings {
  id                     String   @id @default("default")
  storeName              String   @default("Hiwood")
  tagline                String   @default("Carry Your World")
  contactEmail           String   @default("support@hiwood.pk")
  contactPhone           String   @default("+92 300 1234567")
  address                String   @default("Plot 42, Sector 15, Korangi Industrial Area, Karachi, Pakistan")
  currency               String   @default("Rs.")
  standardShippingFee    Float    @default(250)
  freeShippingThreshold  Float    @default(3000)
  codEnabled             Boolean  @default(true)
  bankTransferEnabled    Boolean  @default(true)
  bankDetails            String   @default("Bank: Meezan Bank Ltd\nTitle: Hiwood Bags (Pvt) Ltd\nAccount: 01020304050607\nIBAN: PK65MEZN0001020304050607")
  heroHeading            String   @default("Carry Your World")
  heroSubheading         String   @default("Premium quality backpacks designed for your everyday adventures. Style, comfort and durability — all in one.")
  heroButtonText         String   @default("Shop Now")
  heroImageUrl           String   @default("/images/hero-backpack.png")
  promoHeading           String   @default("Bags for Every Journey")
  promoSubheading        String   @default("Travel • Study • Work • Adventure")
  promoButtonText        String   @default("Shop Collection")
  promoImageUrl          String   @default("/images/banner-lifestyle.png")
  announcementText       String   @default("⚡ Special Offer: Free Nationwide Delivery on Orders over Rs. 3,000 | Use Code HIWOOD10 for 10% Off!")
  announcementActive     Boolean  @default(true)
  returnPolicyText       String   @default("We offer a hassle-free 7-day return and exchange policy for all unworn backpacks in original packaging.")
  shippingPolicyText     String   @default("Delivery within 2-4 business days across major cities in Pakistan (Karachi, Lahore, Islamabad, etc.). Free shipping on orders above Rs. 3,000.")
  updatedAt              DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  entity     String
  details    String?
  createdAt  DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
